# AgroVision AI Environment Configuration
# ==============================================================================

# Database Configuration (Defaults to SQLite if PostgreSQL is not available)
DATABASE_URL=sqlite:///./agrovision.db
# DATABASE_URL=postgresql://user:password@localhost:5432/agrovision

# JWT Security Configuration
JWT_SECRET=agrovision_ai_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# External API Keys & Multi-Tier AI Providers
# ------------------------------------------------------------------------------

# 1. Weather Intelligence (OpenWeatherMap API)
# If provided, backend calls OpenWeatherMap real-time & 5-day forecast.
# If omitted, backend automatically calls Open-Meteo High-Resolution Global API (100% free, real telemetry).
OPENWEATHER_API_KEY=
WEATHER_API_KEY=

# 2. AI Farm Agent & Multimodal Vision AI (Google Gemini)
# Used for conversational agronomy reasoning and multimodal crop foliage/fruit/seed diagnostics.
# If omitted, system seamlessly runs built-in PyTorch MobileNetV2 + Expert Agronomic Decision Engines.
GEMINI_API_KEY=
AI_API_KEY=
GOOGLE_API_KEY=

# 3. Satellite Earth Observation (Optional Commercial Provider Keys)
# If omitted, system utilizes open Copernicus Sentinel-2 L2A STAC APIs + Phenology Spectral Indexing.
COPERNICUS_API_KEY=
AGROMONITORING_API_KEY=

# ------------------------------------------------------------------------------
# Server Network Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
